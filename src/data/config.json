{
  "debug": false,
  "commentMaxLen": 1000,
  "prefixComment": "VocabRadar🎯\n",
  "prefixCopy": "VocabRadar🎯\n",
  "toastDuration": 2500,
  "panelHideDelay": 500,
  "tooltipShowDelay": 300,
  "asrSegmentSec": 30,
  "asrCacheSegmentSec": 60,
  "asrFirstChunkSec": 60,
  "cacheAsr": true,
  "rankThreshold": 5000,
  "rankThresholdMax": 0,
  "rankStep": 1000,
  "asrModelSize": "large-v3-turbo",
  "annotateOov": false,
  "uiLanguage": "en",
  "textStyle": "green-background",
  "annotationStyle": "green-background",
  "videoAnnotationStyle": "green-background",
  "annTemplate": "{target}{annotation}",
  "subtitleStyle": "white-shadow",
  "subtitlePosition": "b15",
  "subtitleCustom": { "bg": "#000000", "fg": "#ffffff", "fontSizePct": 5, "fontFamily": "sans" },
  "videoOverlayAnnStyle": "yellow-yellow",
  "annotateRepeat": false,
  "chatContextMaxBytes": 100000,
  "chatWordPrompt": "Explain \"{text}\" in {lang} as a dictionary entry: part of speech, core meanings, and one example sentence with a {lang} translation. If the context above shows how it is used, give that meaning first.",
  "chatSidebarPrompt": "Summarize the text above in {lang}: only the key points, concise and faithful to the original. Do not interpret or add anything.",
  "llmTranslatePrompt": "Translate \"{text}\" into {lang}. Output only the translation: no explanations, no quotes.",
  "llmProvider": "pollinations",
  "llmBaseUrl": "",
  "llmModel": "",
  "llmApiKey": "",
  "deactivateRules": [
    { "pat": "vocabradar.com", "query": true, "hint": true, "textSidebar": true, "videoSidebar": true, "overlay": true },
    { "pat": "localhost", "query": false, "hint": true, "textSidebar": false, "videoSidebar": false, "overlay": false },
    { "pat": "127.*.*.*", "query": false, "hint": true, "textSidebar": false, "videoSidebar": false, "overlay": false },
    { "pat": "10.*.*.*", "query": false, "hint": true, "textSidebar": false, "videoSidebar": false, "overlay": false },
    { "pat": "172.*.*.*", "query": false, "hint": true, "textSidebar": false, "videoSidebar": false, "overlay": false },
    { "pat": "192.168.*.*", "query": false, "hint": true, "textSidebar": false, "videoSidebar": false, "overlay": false }
  ]
}
